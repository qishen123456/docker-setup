# =========================
# SmartAsk 生产环境配置
# 使用方式：cp .env.production .env && docker-compose up -d
# =========================

# === 部署模式 ===
DEPLOY_MODE=production  # local = 本地开发，production = 生产环境

# === 端口配置（生产模式：不对外暴露，由外部Nginx或负载均衡代理）===
SMARTASK_BACKEND_PORT=5002  # 仅 Docker 内部使用
SMARTASK_FRONTEND_PORT=80   # 仅 Docker 内部使用

# === 公网访问地址 ===
# 你的实际地址：https://bifine.angelgroup.com.cn:10899/smart-ask
PUBLIC_DOMAIN=bifine.angelgroup.com.cn
PUBLIC_PROTOCOL=https
PUBLIC_PORT=10899
BASE_PATH=/smart-ask  # URL路径前缀（如果有）

# === 后端基础 URL（通过外部Nginx/负载均衡代理）===
BACKEND_URL=${PUBLIC_PROTOCOL}://${PUBLIC_DOMAIN}:${PUBLIC_PORT}${BASE_PATH}
FRONTEND_URL=${PUBLIC_PROTOCOL}://${PUBLIC_DOMAIN}:${PUBLIC_PORT}${BASE_PATH}

# === 飞书 OAuth 回调地址 ===
# 注意：需要在飞书开放平台配置此回调URL
FEISHU_REDIRECT_URI=${PUBLIC_PROTOCOL}://${PUBLIC_DOMAIN}:${PUBLIC_PORT}${BASE_PATH}/api/auth/feishu/callback
FEISHU_FRONTEND_CALLBACK_URL=${PUBLIC_PROTOCOL}://${PUBLIC_DOMAIN}:${PUBLIC_PORT}${BASE_PATH}

# === Docker内部Nginx配置（可选，如果Docker内还需要一层Nginx）===
ENABLE_NGINX=false  # 设为false，因为外部已有Nginx/负载均衡处理HTTPS和端口
NGINX_PORT=80       # Docker内部Nginx端口（如果启用）

# =========================
# 重要说明：
# 1. 外部Nginx/负载均衡已处理 HTTPS + 端口10899 + /smart-ask 路径
# 2. Docker容器只需暴露内部服务，由外部代理转发
# 3. 如果外部Nginx直接转发到backend/frontend容器，可注释掉docker-compose.prod.yml中的nginx服务
# =========================

# =========================
# 以下继承自 .env 基础配置
# （数据库、飞书 App ID/Secret、AI 模型等）
# 注意：生产环境请修改以下安全配置：
# - SMARTASK_SECRET_KEY（改为强密码）
# - SMARTASK_DB_PASSWORD（改为强密码）
# - SMARTASK_ADMIN_PASSWORD（改为强密码）
# =========================
