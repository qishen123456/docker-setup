    PAAbility --> BuildRate["建联率"]
    PAAbility --> RoomRate["量房率"]
    PAAbility --> RoomConvert["量房转化率"]
    PAAbility --> LeadClose["线索闭单率"]

    Response --> Level2Follow["二级PA分配及时率"]
