# =========================================================
# SmartAsk 环境变量模板
# 用法：
#   1) 把本文件复制为 .env （Windows deploy.ps1 / Linux deploy.sh 也会自动复制）
#   2) 替换所有标注 “请填写” 的值后再运行部署脚本
#   3) .env 不会被提交到 Git，密钥安全
# =========================================================

# ---------- 系统级 ----------
SMARTASK_BACKEND_PORT=5002
SMARTASK_FRONTEND_PORT=8080
SMARTASK_DOCKER_PG_PORT=5433
SMARTASK_SECRET_KEY=please-change-me-to-a-random-32-char-string
SMARTASK_DEBUG=false
SMARTASK_CHROMA_PATH=/app/chroma_db
SMARTASK_CONFIG_DIR=/app/config

# ---------- Linux / Docker 构建镜像源 ----------
# 这些变量只影响 Docker 构建、npm 安装和可选的 Docker 镜像源配置。
# 默认不改写宿主机 /etc/apt 源，避免影响用户服务器原有软件源。
# 如果 Docker build 阶段 apt-get 访问慢，可保留 mirrors.aliyun.com。
# 如果海外服务器访问官方源更稳定，可改为 http://deb.debian.org，或留空表示不改写基础镜像源：
# SMARTASK_APT_MIRROR=
SMARTASK_APT_MIRROR=https://mirrors.aliyun.com
SMARTASK_NPM_REGISTRY=https://registry.npmmirror.com
SMARTASK_DOCKER_REGISTRY_MIRRORS=https://docker.m.daocloud.io,https://docker.1ms.run,https://hub-mirror.c.163.com,https://mirror.baidubce.com
SMARTASK_CONFIGURE_APT_MIRROR=0
SMARTASK_SKIP_APT_MIRROR=0
SMARTASK_SKIP_DOCKER_MIRROR=0

# 引导行为：=1 表示忽略已有 bs_datasets，强制覆盖式重新导入元数据/业务数据
SMARTASK_BOOTSTRAP_FORCE_IMPORT=0
# =1 跳过整个 DB 初始化（仅用于排错时只起 Flask）
SMARTASK_BOOTSTRAP_SKIP_DB=0

# ---------- 默认 AI 模型（首次启动播种用） ----------
SMARTASK_AI_LABEL=通义千问 qwen-max
SMARTASK_AI_PROVIDER=dashscope
SMARTASK_AI_MODEL=qwen-max
SMARTASK_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMARTASK_AI_API_KEY=请填写你的AI_API_KEY

# ---------- 默认数据源（首次启动播种用） ----------
SMARTASK_DB_LABEL=商用事业部 PostgreSQL
SMARTASK_DB_TYPE=postgresql
# 容器内访问宿主机外部 PG 时填外部地址；如果就用本 compose 的 postgres，填 postgres
SMARTASK_DB_HOST=postgres
SMARTASK_DB_PORT=5432
SMARTASK_DB_DATABASE=postgres
SMARTASK_DB_USERNAME=postgres
SMARTASK_DB_PASSWORD=postgres
SMARTASK_DB_DRIVER=psycopg2

# ---------- 飞书同步（可选） ----------
SMARTASK_FEISHU_LABEL=商用事业部销售结果表
SMARTASK_FEISHU_DESCRIPTION=同步飞书多维表格数据到 PostgreSQL
SMARTASK_FEISHU_APP_ID=
SMARTASK_FEISHU_APP_SECRET=
SMARTASK_FEISHU_BASE_ID=
SMARTASK_FEISHU_TABLE_ID=
SMARTASK_FEISHU_VIEW_ID=
SMARTASK_FEISHU_TARGET_TABLE=feishu_business_sales
SMARTASK_FEISHU_SYNC_MODE=incremental
SMARTASK_FEISHU_SYNC_FREQUENCY=30
SMARTASK_FEISHU_IS_ACTIVE=false

# ---------- 飞书登录 / 免登（可选） ----------
# 可使用 FEISHU_* 短变量，也可使用 SMARTASK_FEISHU_* 同名配置。
# 不要把真实 AppSecret 提交到 Git。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
BACKEND_URL=http://localhost:5002
FRONTEND_URL=http://localhost:8080
SMARTASK_AUTH_TOKEN_TTL_DAYS=7

# ---------- 本地超管登录 ----------
# 用于系统配置兜底入口；生产/用户机请务必改成强密码，真实密码只写入 .env，不要提交 Git。
SMARTASK_ADMIN_USERNAME=admin
SMARTASK_ADMIN_PASSWORD=please-change-admin-password
SMARTASK_ADMIN_DISPLAY_NAME=超级管理员
