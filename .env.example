# =========================
# SmartAsk local secrets
# 复制本文件为 .env 后填写真实值
# .env 不要上传到 Git，可单独发给用户
# =========================

# Backend
SMARTASK_BACKEND_PORT=5002
SMARTASK_SECRET_KEY=请改成你自己的随机字符串
SMARTASK_DEBUG=false
SMARTASK_CHROMA_PATH=./chroma_db

# Docker 端口
SMARTASK_FRONTEND_PORT=8080
SMARTASK_DOCKER_PG_PORT=5433

# 默认 AI 模型
SMARTASK_AI_LABEL=通义千问 qwen-max
SMARTASK_AI_PROVIDER=dashscope
SMARTASK_AI_MODEL=qwen-max
SMARTASK_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMARTASK_AI_API_KEY=请填写你的AI_API_KEY

# 默认数据源
SMARTASK_DB_LABEL=商用事业部 PostgreSQL
SMARTASK_DB_TYPE=postgresql
SMARTASK_DB_HOST=127.0.0.1
SMARTASK_DB_PORT=5432
SMARTASK_DB_DATABASE=postgres
SMARTASK_DB_USERNAME=postgres
SMARTASK_DB_PASSWORD=请填写你的数据库密码
SMARTASK_DB_DRIVER=psycopg2

# 飞书同步
SMARTASK_FEISHU_LABEL=商用事业部销售结果表
SMARTASK_FEISHU_DESCRIPTION=同步飞书多维表格数据到 PostgreSQL
SMARTASK_FEISHU_APP_ID=请填写你的飞书AppID
SMARTASK_FEISHU_APP_SECRET=请填写你的飞书AppSecret
SMARTASK_FEISHU_BASE_ID=请填写你的BaseID
SMARTASK_FEISHU_TABLE_ID=请填写你的TableID
SMARTASK_FEISHU_VIEW_ID=
SMARTASK_FEISHU_TARGET_TABLE=feishu_business_sales
SMARTASK_FEISHU_SYNC_MODE=incremental
SMARTASK_FEISHU_SYNC_FREQUENCY=30
SMARTASK_FEISHU_IS_ACTIVE=false
