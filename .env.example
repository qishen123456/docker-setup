# ============================================================
# SmartAsk 环境配置文件模板（可直接复制使用）
#
# 使用方法：
#   1. 复制此文件：cp .env.example .env
#   2. 编辑配置：vi .env 或 nano .env
#   3. 修改所有 [必填] 和 [推荐修改] 的配置项
#   4. 保存后启动服务：docker-compose up -d --build
#
# ⚠️ 注意事项：
#   - 不要将包含真实密码/API Key 的 .env 文件提交到 Git
#   - 密码至少32位，包含大小写字母+数字+特殊字符
#   - 两个安全密钥必须不同且随机生成
# ============================================================


# ==================== 一、基础配置 ====================

# 部署模式：local（本地开发）| production（生产环境）
DEPLOY_MODE=production


# ==================== 二、公网访问地址配置 [必填] ====================
# 这些配置决定了用户如何通过浏览器访问你的系统

# 公网域名或IP地址
PUBLIC_DOMAIN=bifine.angelgroup.com.cn

# 访问协议：http | https
PUBLIC_PROTOCOL=https

# 对外暴露的端口号（外部Nginx监听的端口）
PUBLIC_PORT=10899

# URL路径前缀（如果有子目录就填，否则填 /）
# 示例：https://domain.com/smart-ask → BASE_PATH=/smart-ask
# 示例：https://domain.com/        → BASE_PATH=/
BASE_PATH=/smart-ask

# 后端基础URL（自动拼接，一般不需要手动改）
BACKEND_URL=${PUBLIC_PROTOCOL}://${PUBLIC_DOMAIN}:${PUBLIC_PORT}${BASE_PATH}

# 前端基础URL（自动拼接，一般不需要手动改）
FRONTEND_URL=${PUBLIC_PROTOCOL}://${PUBLIC_DOMAIN}:${PUBLIC_PORT}${BASE_PATH}


# ==================== 三、Docker端口配置 ====================
# 这些端口只在服务器内部使用，不对外暴露

# 后端API端口（Docker内部使用）
SMARTASK_BACKEND_PORT=5002

# 前端HTTP端口（Docker内部使用）
SMARTASK_FRONTEND_PORT=8888

# PostgreSQL数据库端口（Docker内部使用，不要改成5432避免冲突）
SMARTASK_DOCKER_PG_PORT=5433

# 是否启用Docker内部Nginx（false=使用外部Nginx，true=Docker内再套一层）
ENABLE_NGINX=false


# ==================== 四、数据库配置 [必填 + 推荐修改] ====================

# 数据库名称
SMARTASK_DB_DATABASE=smartask_db

# 数据库用户名（不要用 root/postgres）
SMARTASK_DB_USERNAME=smartask_user

# 数据库密码 [⚠️ 必须修改！生成方法见下方]
# ⚠️ 至少32位！包含大小写字母+数字+特殊字符！
#
# 生成强密码的方法（在服务器上执行）：
#   openssl rand -base64 32
#   或
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 示例输出：Xk9#mP2$vL5@nQ8wR4tY7uI0oP3sA6dF9gH1jL5nQ8wR
SMARTASK_DB_PASSWORD=YourStrongPasswordHere_ReplaceThisWithRealPassword_AtLeast32Chars

# PostgreSQL超级用户密码（可以和上面一样）
SMARTASK_POSTGRES_PASSWORD=${SMARTASK_DB_PASSWORD}


# ==================== 五、管理员账号配置 [必填 + 推荐修改] ====================
# ⚠️ 首次部署后立即登录并修改这些密码！

# 管理员用户名
SMARTASK_ADMIN_USERNAME=admin

# 管理员密码 [⚠️ 必须修改！不要用简单密码]
# ❌ 错误示例：admin123456、password、12345678
# ✅ 正确示例：Admin@2026Secure!Passw0rd
SMARTASK_ADMIN_PASSWORD=YourAdminPasswordHere_ChangeImmediately

# 管理员显示名称
SMARTASK_ADMIN_DISPLAY_NAME=系统管理员


# ==================== 六、AI模型配置 [必填] ====================
# SmartAsk 核心功能依赖AI模型，必须配置！
#
# 当前支持的AI服务商（选一个取消注释）：

# ====== 方式一：DeepSeek（推荐！性价比高，中文效果好）======
SMARTASK_AI_API_KEY=sk-your-deepseek-api-key-here
SMARTASK_AI_BASE_URL=https://api.deepseek.com/v1/
SMARTASK_AI_MODEL=deepseek-chat

# ====== 方式二：OpenAI（最稳定但较贵）======
# SMARTASK_AI_API_KEY=sk-your-openai-api-key-here
# SMARTASK_AI_BASE_URL=https://api.openai.com/v1/
# SMARTASK_AI_MODEL=gpt-4o

# ====== 方式三：通义千问（阿里云）======
# SMARTASK_AI_API_KEY=sk-your-dashscope-key
# SMARTASK_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
# SMARTASK_AI_MODEL=qwen-plus

# ====== 方式四：智谱AI（GLM-4）======
# SMARTASK_AI_API_KEY=your-zhipu-api-key
# SMARTASK_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# SMARTASK_AI_MODEL=glm-4

# ====== 方式五：其他兼容OpenAI格式的接口 ======
# SMARTASK_AI_API_KEY=your-custom-api-key
# SMARTASK_AI_BASE_URL=https://your-custom-endpoint/v1/
# SMARTASK_AI_MODEL=model-name

# 获取API Key的方法：
# 1. DeepSeek: https://platform.deepseek.com/ （注册后有免费额度）
# 2. OpenAI: https://platform.openai.com/ （需要绑卡付费）
# 3. 通义千问: https://dashscope.console.aliyun.com/ （阿里云账号）
# 4. 智谱AI: https://open.bigmodel.cn/ （注册有免费额度）


# ==================== 七、安全密钥配置 [必填 + 必须随机生成] ====================
# ⚠️ 生产环境必须随机生成！绝对不能使用默认值！
# 泄露后果：攻击者可以伪造任意用户的登录态！

# Flask Session/JWT签名密钥（用于加密用户会话）
# 生成命令：python3 -c "import secrets; print(secrets.token_hex(32))"
# 输出示例：a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
SMARTASK_SECRET_KEY=your-random-secret-key-here-at-least-64-characters-long

# Flask Session密钥（另一个随机密钥，⚠️ 必须和上面的不一样！）
# 再次执行：python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=another-random-secret-key-here-different-from-above


# ==================== 八、飞书集成配置 [可选] ====================
# 如果你使用飞书数据同步或飞书登录，才需要配置这部分

# 飞书应用的 App ID（在飞书开发者后台获取）
# 获取地址：https://open.feishu.cn/app → 选择应用 → 凭证与基础信息
SMARTASK_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# 飞书应用的 App Secret（同上页面获取）
SMARTASK_FEISHU_APP_SECRET=your-feishu-app-secret-here

# 飞书 OAuth 回调URL（自动拼接，但要确保和飞书平台配置一致）
FEISHU_REDIRECT_URI=${PUBLIC_PROTOCOL}://${PUBLIC_DOMAIN}:${PUBLIC_PORT}${BASE_PATH}/api/auth/feishu/callback

# 飞书回调后的前端跳转URL
FEISHU_FRONTEND_CALLBACK_URL=${PUBLIC_PROTOCOL}://${PUBLIC_DOMAIN}:${PUBLIC_PORT}${BASE_PATH}

# 飞书配置检查清单：
# [ ] 已在飞书开放平台创建应用
# [ ] 已获取 App ID 和 App Secret
# [ ] 已在「安全设置」中添加重定向URL（必须和上面的 FEISHU_REDIRECT_URI 完全一致）
# [ ] 已发布新版本（修改配置后必须发布才生效！）
# [ ] 已开通必要的API权限（如：获取用户基本信息等）


# ==================== 九、Docker构建优化配置 [可选] ====================
# 国内服务器建议配置镜像加速，否则构建会很慢（可能超时失败）

# APT包管理器镜像源（Debian/Ubuntu系统包）
# 可选值：https://mirrors.aliyun.com | https://mirrors.tuna.tsinghua.edu.cn
SMARTASK_APT_MIRROR=https://mirrors.aliyun.com

# NPM镜像源（Node.js包）
# 可选值：https://registry.npmmirror.com | https://registry.npm.taobao.org
SMARTASK_NPM_REGISTRY=https://registry.npmmirror.com

# pip镜像源（Python包）
# 可选值：https://mirrors.aliyun.com/pypi/simple/ | https://pypi.tuna.tsinghua.edu.cn/simple
SMARTASK_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# pip可信主机（和上面的镜像源域名保持一致）
SMARTASK_PIP_TRUSTED_HOST=mirrors.aliyun.com

# Docker Hub镜像加速（多个用逗号分隔）
# 国内常用加速器：
#   - https://docker.m.daocloud.io
#   - https://docker.1ms.run
#   - https://hub-mirror.c.163.com
SMARTASK_DOCKER_REGISTRY_MIRRORS=https://docker.m.daocloud.io,https://docker.1ms.run


# ==================== 十、Bootstrap控制配置 [一般不需要改] ====================
# 是否跳过内置数据集导入（首次部署建议保持默认）
SMARTASK_BOOTSTRAP_SKIP_BUILTINS=1

# 是否跳过首次数据导入
SMARTASK_BOOTSTRAP_SKIP_FIRST_IMPORT=1

# 飞书同步启动模式
# auto（默认）：智能判断，新表/空表启动时自动同步，已有数据的表跳过
# force：启动时强制同步所有启用的飞书配置（用于强制刷数）
# skip：跳过启动同步，只启动定时任务调度器（适合本地开发频繁重启）
SMARTASK_FEISHU_SYNC_ON_STARTUP=auto


# ==================== 十一、高级加密配置 [可选] ====================
# 只有当 config/*.json 使用了 enc:v1 密文格式时才需要配置
# 如果你的配置文件都是明文，可以忽略这部分

# 加密主密钥（用于解密配置文件中的敏感信息）
# SMARTASK_SECRET_MASTER_KEY=your-master-encryption-key

# 密钥文件路径（如果用文件存储密钥）
# SMARTASK_SECRET_KEY_FILE=config/.secret_master_key


# ============================================================
# 配置完成后的验证步骤
# ============================================================
#
# 1. 测试配置文件语法是否正确（虽然没有语法检查工具，但可以查看是否有明显错误）
#    cat .env | grep -v "^#" | grep -v "^$" | head -20
#
# 2. 启动服务
#    docker-compose -f docker-compose.yml -f docker-compose.proxy.yml up -d --build
#
# 3. 检查容器状态
#    docker-compose ps
#    # 预期：所有容器都是 Up (healthy) 状态
#
# 4. 测试后端健康检查
#    curl http://localhost:5002/api/health
#    # 预期：{"status":"ok","version":"...","timestamp":"..."}
#
# 5. 测试前端访问
#    curl -I http://localhost:8888/
#    # 预期：HTTP/1.1 200 OK
#
# 6. 浏览器访问公网地址
#    https://bifine.angelgroup.com.cn:10899/smart-ask/
#    # 预期：看到登录页面
#
# ============================================================


# ============================================================
# 常见配置错误排查
# ============================================================

# ❌ 错误1：密码太短或太简单
#    现象：容器启动后很快退出，日志提示认证失败
#    解决：确保密码至少32位，包含大小写+数字+特殊字符

# ❌ 错误2：两个安全密钥相同
#    现象：Session验证失败，无法登录
#    解决：重新生成两个不同的随机密钥

# ❌ 错误3：AI API Key 无效
#    现象：提问时报错"API Key无效"或"401 Unauthorized"
#    解决：检查 API Key 是否正确，是否已充值/激活

# ❌ 错误4：飞书回调URL不匹配
#    现象：飞书登录提示"OAuth state 校验失败"
#    解决：对比 .env 和飞书平台的配置，确保完全一致（包括末尾的斜杠）

# ❌ 错误5：端口被占用
#    现象：启动时提示"port is already allocated"
#    解决：netstat -tlnp | grep :5002 查看占用进程，或修改端口号

# ============================================================
