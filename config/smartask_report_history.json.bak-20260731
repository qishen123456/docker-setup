                          "前",
                          "后",
                          "最高",
                          "最低",
                          "最好",
                          "最差",
                          "倒数",
                          "垫底"
                        ],
                        "defaultTopN": 10,
                        "maxTopN": 20,
                        "defaultMetricKey": "rate",
                        "defaultDirection": "desc",
                        "negativeTriggers": [
                          "最低",
                          "最差",
                          "后",
                          "倒数",
                          "垫底",
                          "落后"
