                "riskThreshold": 10,
                "officeRiskThreshold": 10,
                "officeBenchmarkThreshold": 85,
                "personRiskThreshold": 10,
                "personBenchmarkThreshold": 85,
                "signalRules": [
                  {
                    "op": ">=",
                    "key": "rate",
                    "tone": "good",
                    "label": "标杆",
                    "value": 85
                  },
                  {
                    "op": ">=",
                    "key": "rate",
                    "tone": "warn",
                    "label": "需推进",
                    "value": 10
                  },
                  {
                    "op": "<",
                    "key": "rate",
                    "tone": "danger",
                    "label": "风险",
                    "value": 10
                  }
                ],
                "intentPolicies": {
                  "ranking": {
                    "enabled": true,
                    "triggers": [
                      "排名",
                      "排行",
                      "Top",
                      "前",
                      "后",
                      "最高",
                      "最低",
                      "最好",
                      "最差",
                      "倒数",
                      "垫底"
                    ],
                    "defaultTopN": 3,
                    "maxTopN": 20,
                    "defaultMetricKey": "rate",
                    "defaultDirection": "desc",
                    "negativeTriggers": [
                      "最低",
                      "最差",
                      "后",
                      "倒数",
                      "垫底",
                      "落后"
                    ],
                    "targetLevelAliases": {
