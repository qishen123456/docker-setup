                          "消费者事业部",
                          "垫底的5个城市分公司"
                        ],
                        "source": "question_subject_coordinated"
                      }
                    ],
                    "intent": "compare",
                    "ranking_params": {
                      "direction": "asc",
                      "metric_hint": null,
                      "rank_sides": "bottom",
