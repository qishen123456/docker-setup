                  "layoutTemplate": "ranking",
                  "analysisMode": "ranking"
                },
                "analysis": "## 业绩分析报告\n\n### 核心结论\n本次已按年度开单金额输出 10 个业务代表的排名结果：靳锋位列第1（榜首），年度开单金额2991万；栾天龙位于第10（末位），年度开单金额332万，首尾相差2659万；但靳锋达成率仅33.24%，仍低于60%红线。\n\n### 亮点分析\n• **榜首对象：** 靳锋 -> 年度开单金额 2991万 -> 达成率 33.24% -> 可作为当前口径的优先复盘样本。\n• **前三结果：** 靳锋、韩晓娇、贾希 -> 先看头部样本，再结合完整排名表继续核对差距来源。\n\n### 问题诊断\n• **末位对象：** 栾天龙 -> 年度开单金额 332万 -> 达成率 55.34% -> 建议优先核对任务缺口、项目推进和资源投入。\n• **风险提示：** 当前结果内低于20%风险线的节点 0 个，暂无明显低于20%的节点。\n\n### 改进建议\n• 先按年度开单金额复盘榜首与末位对象的差距来源，避免继续按默认达成率口径解释本轮排序。\n• 完整 10 个业务代表名单以排名表为准；如需继续拆因，优先下钻末位对象的下级明细。\n• 风险识别仍以达成率、剩余缺口和项目推进节奏综合判断，避免只看相对名次。\n\n> SQL复核：规则 SQL 已通过只读与字段字典校验，Agent3 不改写系统规则 SQL。",
                "sql": "SELECT * FROM (\nWITH 业务代表原始 AS (\n    SELECT\n        TRIM(COALESCE(CASE WHEN jsonb_typeof(fields->'分公司') = 'array' THEN fields->'分公司'->0->>'text' ELSE fields->>'分公司' END, '')) AS 分公司,\n        TRIM(COALESCE(CASE WHEN jsonb_typeof(fields->'代表处') = 'array' THEN fields->'代表处'->0->>'text' ELSE fields->>'代表处' END, '')) AS 代表处,\n        '' AS 业务部,\n        TRIM(COALESCE(CASE WHEN jsonb_typeof(fields->'业务代表') = 'array' THEN fields->'业务代表'->0->>'text' ELSE fields->>'业务代表' END, '')) AS 业务代表,\n        SUM(COALESCE(NULLIF(regexp_replace(COALESCE(CASE WHEN jsonb_typeof(fields->'总任务（金额）') = 'array' THEN fields->'总任务（金额）'->0->>'text' ELSE fields->>'总任务（金额）' END, '0'), '[^0-9.-]', '', 'g'), ''), '0')::NUMERIC) AS 总任务金额,\n        SUM(COALESCE(NULLIF(regexp_replace(COALESCE(CASE WHEN jsonb_typeof(fields->'年度开单金额') = 'array' THEN fields->'年度开单金额'->0->>'text' ELSE fields->>'年度开单金额' END, '0'), '[^0-9.-]', '', 'g'), ''), '0')::NUMERIC) AS 年度开单金额\n    FROM angel_group_data\n    WHERE COALESCE(NULLIF(TRIM(CASE WHEN jsonb_typeof(fields->'当前年') = 'array' THEN fields->'当前年'->0->>'text' ELSE fields->>'当前年' END), ''), '2026') = '2026'\n    GROUP BY 1, 2, 3, 4\n),\n业务代表汇总 AS (\n    SELECT\n        CASE\n            WHEN COALESCE(NULLIF(分公司, ''), NULLIF(业务部, '')) LIKE '%业务部' THEN '行业条线'\n            WHEN COALESCE(NULLIF(分公司, ''), NULLIF(业务部, '')) LIKE '%分公司' THEN '区域条线'\n            ELSE '事业部层级'\n        END AS 条线,\n        '业务代表' AS 层级,\n        业务代表 AS 节点名称,\n        COALESCE(NULLIF(代表处, ''), NULLIF(业务部, ''), NULLIF(分公司, ''), '商用事业部') AS 上级名称,\n        NULLIF(分公司, '') AS 分公司,\n        NULLIF(代表处, '') AS 代表处,\n        NULLIF(业务部, '') AS 业务部,\n        concat_ws(' / ', NULLIF(分公司, ''), NULLIF(代表处, ''), NULLIF(业务部, ''), NULLIF(业务代表, '')) AS 组织路径,\n        SUM(总任务金额) AS 总任务金额,\n        SUM(年度开单金额) AS 年度开单金额\n    FROM 业务代表原始\n    WHERE 业务代表 <> ''\n    GROUP BY 分公司, 代表处, 业务部, 业务代表\n),\n业务代表结果 AS (\n    SELECT\n        条线,\n        层级,\n        组织路径,\n        节点名称,\n        上级名称,\n        分公司,\n        代表处,\n        业务部,\n        总任务金额,\n        年度开单金额,\n        CASE WHEN 总任务金额 = 0 THEN 0 ELSE ROUND((年度开单金额 / 总任务金额) * 100, 2) END AS 达成率,\n        ROUND(总任务金额 - 年度开单金额, 2) AS 剩余任务金额\n    FROM 业务代表汇总\n)\n,\n业务代表全局排序 AS (\n    SELECT\n        *,\n        ROW_NUMBER() OVER (\n            ORDER BY 年度开单金额 DESC, 剩余任务金额 DESC, 组织路径\n        ) AS 全局排名\n    FROM 业务代表结果\n)\nSELECT *\nFROM 业务代表全局排序\nWHERE 全局排名 <= 10\nORDER BY 全局排名, 年度开单金额 DESC, 剩余任务金额 DESC, 组织路径\nLIMIT 10\n) AS __smartask_row_scope\nWHERE ((to_jsonb(__smartask_row_scope)->>'组织编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR (to_jsonb(__smartask_row_scope)->>'分公司编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR (to_jsonb(__smartask_row_scope)->>'部门编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR (to_jsonb(__smartask_row_scope)->>'节点编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR (to_jsonb(__smartask_row_scope)->>'节点名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'上级名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'组织名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'分公司') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'事业部') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'业务部') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'代表处') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'城市公司') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'部门') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'条线') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'区域') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'公司名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR POSITION('商用事业部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('东部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('工业医疗业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('北部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('西部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('公共办公业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('南部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('餐饮业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('商用事业部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('东部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('工业医疗业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('北部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('西部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('公共办公业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('南部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('餐饮业务部' IN CO