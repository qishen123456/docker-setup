                "analysis": "业绩分析报告\n\n【核心结论】\n山东分公司整体达成率53.60%，低于60%经营红线，年度开单缺口高达4659万。下属城市公司严重分化：临沂城市公司以81.54%的达成率领跑，而淄博城市公司仅7.72%，是拖累分公司整体进度的最大风险点。\n\n【亮点分析 •】\n临沂城市公司是山东分公司唯一表现较好的单元，达成率81.54%，实际开单2697万，贡献了分公司50%的业绩。其线下主业务开单2697.45万，任务完成率88.4%，远超其他城市公司，证明线下渠道在该区域具备可复制的打法。\n\n【问题诊断 •】\n1. 结构性风险：分公司整体达成率53.60%，距60%红线差6.4个百分点，剩余缺口4659万。若剔除临沂，其余4家城市公司合计达成率仅34.4%，整体基本盘非常脆弱。\n2. 极端分化：淄博城市公司达成率仅7.72%，开单104万，剩余缺口1249万，几乎处于停滞状态；青岛城市公司达成率37.03%，缺口1261万。仅淄博与青岛两家的剩余任务就占分公司总缺口的54%，是当前最大的失血点。\n3. 业务线单一：所有实际开单均来自线下主业务，新零售、燃气定制实际开单均为0，业务结构缺乏抗风险能力，未能形成第二增长曲线。\n\n【改进建议】\n1. 立即对淄博城市公司启动专项复盘与帮扶，由分公司负责人牵头，限期两周内输出问题诊断与追赶计划，重点解决线下渠道的破零与上量问题。\n2. 将临沂城市公司的线下打法（客户拓展、转化路径、团队配置）提炼为标准动作手册，强制在青岛、济南、烟台三地复制推广，设定月度对标目标。\n3. 针对新零售与燃气定制业务线，分公司层面需明确责任人，制定Q3破零计划，避免全年挂零，为明年业务结构优化打下基础。\n4. 建议将山东分公司整体达成率目标分解到月度，建立双周进度预警机制，对淄博、青岛实施周度跟踪，确保缺口不再扩大。",
                "sql": "SELECT * FROM (\nWITH 字段提取 AS (\n    SELECT\n        id,\n        COALESCE(NULLIF(TRIM(fields->>'事业部'), ''), '消费者事业部') AS 事业部,\n        COALESCE(NULLIF(TRIM(fields->>'分公司'), ''), '') AS 分公司,\n        COALESCE(NULLIF(TRIM(fields->>'城市分公司'), ''), '') AS 城市分公司,\n        COALESCE(NULLIF(TRIM(fields->>'层级级别'), ''), '') AS 源层级,\n        COALESCE(NULLIF(TRIM(fields->>'当前年'), ''), '2026') AS 当前年,\n        NULLIF(regexp_replace(COALESCE(fields->>'总任务（金额）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 总任务原值,\n        NULLIF(regexp_replace(COALESCE(fields->>'年度开单金额', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 年度开单原值,\n        NULLIF(regexp_replace(COALESCE(fields->>'线下（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 线下任务万,\n        NULLIF(regexp_replace(COALESCE(fields->>'新零售（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 新零售任务万,\n        NULLIF(regexp_replace(COALESCE(fields->>'燃气定制（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 燃气定制任务万,\n        NULLIF(regexp_replace(COALESCE(fields->>'地产（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 地产任务万,\n        NULLIF(regexp_replace(COALESCE(fields->>'线下-年度开单金额（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 线下实际万,\n        NULLIF(regexp_replace(COALESCE(fields->>'新零售-年度开单金额（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 新零售实际万,\n        NULLIF(regexp_replace(COALESCE(fields->>'燃气定制-年度开单金额（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 燃气定制实际万,\n        NULLIF(regexp_replace(COALESCE(fields->>'地产-年度开单金额（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 地产实际万\n    FROM public.feishu_tbl_xioafeizhe\n    WHERE fields IS NOT NULL\n),\n标准行 AS (\n    SELECT\n        id,\n        CASE\n            WHEN 城市分公司 <> '' THEN '城市分公司'\n            WHEN 分公司 <> '' THEN '分公司'\n            ELSE '消费者事业部总体'\n        END AS 层级,\n        CASE\n            WHEN 城市分公司 <> '' THEN 城市分公司\n            WHEN 分公司 <> '' THEN 分公司\n            ELSE 事业部\n        END AS 节点名称,\n        CASE\n            WHEN 城市分公司 <> '' THEN 分公司\n            WHEN 分公司 <> '' THEN 事业部\n            ELSE NULL\n        END AS 上级名称,\n        COALESCE(总任务原值, (COALESCE(线下任务万, 0) + COALESCE(新零售任务万, 0) + COALESCE(燃气定制任务万, 0) + COALESCE(地产任务万, 0)) * 10000, 0) AS 总任务金额,\n        COALESCE(年度开单原值, (COALESCE(线下实际万, 0) + COALESCE(新零售实际万, 0) + COALESCE(燃气定制实际万, 0) + COALESCE(地产实际万, 0)) * 10000, 0) AS 年度开单金额,\n        COALESCE(线下任务万, 0) AS 线下任务_万元,\n        COALESCE(新零售任务万, 0) AS 新零售任务_万元,\n        COALESCE(燃气定制任务万, 0) AS 燃气定制任务_万元,\n        COALESCE(地产任务万, 0) AS 地产任务_万元,\n        COALESCE(线下实际万, 0) AS 线下实际_万元,\n        COALESCE(新零售实际万, 0) AS 新零售实际_万元,\n        COALESCE(燃气定制实际万, 0) AS 燃气定制实际_万元,\n        COALESCE(地产实际万, 0) AS 地产实际_万元\n    FROM 字段提取\n    WHERE 当前年 = '2026'\n      AND (事业部 = '消费者事业部' OR 分公司 <> '' OR 城市分公司 <> '')\n),\n汇总结果 AS (\n    SELECT\n        '消费者经营链路' AS 条线,\n        '全部' AS 分析口径,\n        层级,\n        节点名称,\n        上级名称,\n        ROUND((总任务金额), 2) AS 总任务金额,\n        ROUND((年度开单金额), 2) AS 年度开单金额,\n        CASE WHEN (总任务金额) > 0 THEN ROUND((年度开单金额) / (总任务金额) * 100, 2) ELSE 0 END AS 达成率,\n        ROUND(GREATEST((总任务金额) - (年度开单金额), 0), 2) AS 剩余任务金额,\n        ROUND(线下任务_万元, 2) AS 线下任务_万元,\n        ROUND(新零售任务_万元, 2) AS 新零售任务_万元,\n        ROUND(燃气定制任务_万元, 2) AS 燃气定制任务_万元,\n        ROUND(地产任务_万元, 2) AS 地产任务_万元,\n        ROUND(线下实际_万元, 2) AS 线下实际_万元,\n        ROUND(新零售实际_万元, 2) AS 新零售实际_万元,\n        ROUND(燃气定制实际_万元, 2) AS 燃气定制实际_万元,\n        ROUND(地产实际_万元, 2) AS 地产实际_万元\n    FROM 标准行\n    WHERE 节点名称 <> ''\n      AND ((总任务金额) > 0 OR (年度开单金额) > 0)\n)\nSELECT *\nFROM 汇总结果\n\nWHERE 节点名称 IN ('山东分公司')\n   OR 上级名称 IN ('山东分公司')\n   OR 上级名称 IN (\n       SELECT 节点名称\n       FROM 汇总结果\n       WHERE 节点名称 IN ('山东分公司') OR 上级名称 IN ('山东分公司')\n   )\n\nORDER BY\n    CASE 层级 WHEN '消费者事业部总体' THEN 0 WHEN '分公司' THEN 1 WHEN '城市分公司' THEN 2 ELSE 9 END,\n    上级名称 NULLS FIRST,\n    达成率 DESC,\n    节点名称\nLIMIT 10000\n) AS __smartask_row_scope\nWHERE ((to_jsonb(__smartask_row_scope)->>'组织编码') IN ('7c38ff2d14dd5515', '1f5bc53566bfa5b2', '4c92717a393b3248', 'e26cc888231cb3c9', '1bbd2a36b2fb686f', '4b66949a1g2g1e8c', '196873fd1d2cfg85', '843a34aa6g3gg763', 'b45ddd151517eag6', 'e99798612e98b4d6', 'bg18ddb2efb2gf61', 'egg37cg26bafg5a9', 'aa34g4b218a28bgf', 'egcc258a8d9c811f') OR (to_jsonb(__smartask_row_scope)->>'分公司编码') IN ('7c38ff2d14dd5515', '1f5bc53566bfa5b2', '4c92717a393b3248', 'e26cc888231cb3c9', '1bbd2a36b2fb686f', '4b66949a1g2g1e8c', '196873fd1d2cfg85', '843a34aa6g3gg763', 'b45ddd151517eag6', 'e99798612e98b4d6', 'bg18ddb2efb2gf61', 'egg37cg26bafg5a9', 'aa34g4b218a28bgf', 'egcc258a8d9c811f') OR (to_jsonb(__smartask_row_scope)->>'部门编码') IN ('7c38ff2d14dd5515', '1f5bc53566bfa5b2', '4c92717a393b3248', 'e26cc888231cb3c9', '1bbd2a36b2fb686f', '4b66949a1g2g1e8c', '196873fd1d2cfg85', '843a34aa6g3gg763', 'b45ddd151517eag6', 'e99798612e98b4d6', 'bg18ddb2efb2gf61', 'egg37cg26bafg5a9', 'aa34g4b218a28bgf', 'egcc258a8d9c811f') OR (to_jsonb(__smartask_row_scope)->>'节点编码') IN ('7c38ff2d14dd5515', '1f5bc53566bfa5b2', '4c92717a393b3248', 'e26cc888231cb3c9', '1bbd2a36b2fb686f', '4b66949a1g2g1e8c', '196873fd1d2cfg85', '843a34aa6g3gg763', 'b45ddd151517eag6', 'e99798612e98b4d6', 'bg18ddb2efb2gf61', 'egg37cg26bafg5a9', 'aa34g4b218a28bgf', 'egcc258a8d9c811f') OR POSITION('7c38ff2d14dd5515' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('1f5bc53566bfa5b2' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('4c92717a393b3248' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('e26cc888231cb3c9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('1bbd2a36b2fb686f' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('4b66949a1g2g1e8c' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('196873fd1d2cfg85' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('843a34aa6g3gg763' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('b45ddd151517eag6' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('e99798612e98b4d6' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('bg18ddb2efb2gf61' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('egg37cg26bafg5a9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('aa34g4b218a28bgf' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('egcc258a8d9c811f' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('7c38ff2d14dd5515' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('1f5bc53566bfa5b2' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('4c92717a393b3248' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('e26cc888231cb3c9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('1bbd2a36b2fb686f' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('4b66949a1g2g1e8c' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('196873fd1d2cfg85' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('843a34aa6g3gg763' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('b45ddd151517eag6' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('e99798612e98b4d6' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('bg18ddb2efb2gf61' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('egg37cg26bafg5a9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('aa34g4b218a28bgf' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('egcc258a8d9c811f' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('7c38ff2d14dd5515' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('