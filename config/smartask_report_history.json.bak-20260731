sk_row_scope)->>'组织链路'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR (to_jsonb(__smartask_row_scope)->>'节点名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'上级名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'组织名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'分公司') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'事业部') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'业务部') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'代表处') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'城市公司') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'部门') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'条线') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'区域') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'公司名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR POSITION('商用事业部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('东部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('工业医疗业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('北部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('西部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('公共办公业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('南部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('餐饮业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('商用事业部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('东部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('工业医疗业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('北部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('西部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('公共办公业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('南部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('餐饮业务部' IN COALES