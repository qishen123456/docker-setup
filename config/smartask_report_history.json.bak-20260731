                "report_configs": {
                  "2": {
                    "nameColumn": "节点名称",
                    "parentColumn": "上级名称",
                    "trackColumn": "条线",
                    "levelColumn": "层级",
                    "businessContext": "消费者事业部年度任务达成分析。事业部整体业绩由四大业务板块构成：线下主业务、燃气定制、地产配套、新零售。四个板块任务额相加等于年度总任务金额，四个板块实际开单额相加等于年度开单金额（整体实际完成额），剩余任务金额 = 总任务金额 − 年度开单金额，达成率 = 年度开单金额 ÷ 总任务金额。层级关系：城市分公司 → 分公司 → 消费者事业部总体。城市分公司仅承担线下、燃气定制、新零售三类任务；分公司汇总下辖城市分公司，同样无地产业务；事业部总体汇总全国所有分公司业绩，并叠加独有的地产板块任务与实际成交。地产业务仅事业部总体有非0数据，新零售业务当前所有层级实际开单均为0。源表只有 6 个固定字段，业务字段来自 fields JSONB，SQL 负责投影标准报告列。",
                    "sourceFields": {
                      "organization": [
                        "事业部",
                        "分公司",
                        "城市分公司"
                      ],
                      "time": [
                        "当前年",
                        "当前月",
                        "当前日期"
                      ],
                      "metrics": [
                        "总任务（金额）",
                        "年度开单金额",
                        "总任务达成率",
                        "线下任务",
                        "线下实际",
                        "新零售任务",
                        "新零售实际",
                        "燃气定制任务",
                        "燃气定制实际",
                        "地产任务",
                        "地产实际"
                      ]
                    },
                    "sqlOutputContract": {
                      "amountUnit": "元",
                      "requiredColumns": [
                        "条线",
                        "层级",
                        "节点名称",
                        "上级名称"
                      ],
                      "metricColumns": [
                        "总任务金额",
                        "年度开单金额",
                        "达成率",
                        "剩余任务金额"
                      ],
                      "notes": [
                        "源表没有标准报告列，必须在 SQL 中用 SELECT 别名生成。",
                        "区域链路按 消费者事业部 -> 分公司 -> 城市分公司 输出。",
                        "统计上级节点时使用源表对应层级记录，不能把城市分公司明细重复累加到分公司。",
                        "用户问整体时返回总体、分公司和城市分公司，便于前端动态下钻。"
                      ]
                    },
                    "analysisDimensions": [
                      {
                        "key": "consumer_org_chain",
                        "path": [
                          "消费者事业部",
