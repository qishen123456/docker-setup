            "sql": "SELECT * FROM (\nWITH 字段提取 AS (\n    SELECT\n        id,\n        COALESCE(NULLIF(TRIM(fields->>'事业部'), ''), '消费者事业部') AS 事业部,\n        COALESCE(NULLIF(TRIM(fields->>'分公司'), ''), '') AS 分公司,\n        COALESCE(NULLIF(TRIM(fields->>'城市分公司'), ''), '') AS 城市分公司,\n        COALESCE(NULLIF(TRIM(fields->>'层级级别'), ''), '') AS 源层级,\n        COALESCE(NULLIF(TRIM(fields->>'当前年'), ''), '2026') AS 当前年,\n        NULLIF(regexp_replace(COALESCE(fields->>'总任务（金额）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 总任务原值,\n        NULLIF(regexp_replace(COALESCE(fields->>'年度开单金额', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 年度开单原值,\n        NULLIF(regexp_replace(COALESCE(fields->>'线下（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 线下任务万,\n        NULLIF(regexp_replace(COALESCE(fields->>'新零售（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 新零售任务万,\n        NULLIF(regexp_replace(COALESCE(fields->>'燃气定制（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 燃气定制任务万,\n        NULLIF(regexp_replace(COALESCE(fields->>'地产（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 地产任务万,\n        NULLIF(regexp_replace(COALESCE(fields->>'线下-年度开单金额（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 线下实际万,\n        NULLIF(regexp_replace(COALESCE(fields->>'新零售-年度开单金额（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 新零售实际万,\n        NULLIF(regexp_replace(COALESCE(fields->>'燃气定制-年度开单金额（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 燃气定制实际万,\n        NULLIF(regexp_replace(COALESCE(fields->>'地产-年度开单金额（万）', ''), '[^0-9.-]', '', 'g'), '')::NUMERIC AS 地产实际万\n    FROM public.feishu_tbl_xioafeizhe\n    WHERE fields IS NOT NULL\n),\n标准行 AS (\n    SELECT\n        id,\n        CASE\n            WHEN 城市分公司 <> '' THEN '城市分公司'\n            WHEN 分公司 <> '' THEN '分公司'\n            ELSE '消费者事业部总体'\n        END AS 层级,\n        CASE\n            WHEN 城市分公司 <> '' THEN 城市分公司\n            WHEN 分公司 <> '' THEN 分公司\n            ELSE 事业部\n        END AS 节点名称,\n        CASE\n            WHEN 城市分公司 <> '' THEN 分公司\n            WHEN 分公司 <> '' THEN 事业部\n            ELSE NULL\n        END AS 上级名称,\n        COALESCE(总任务原值, (COALESCE(线下任务万, 0) + COALESCE(新零售任务万, 0) + COALESCE(燃气定制任务万, 0) + COALESCE(地产任务万, 0)) * 10000, 0) AS 总任务金额,\n        COALESCE(年度开单原值, (COALESCE(线下实际万, 0) + COALESCE(新零售实际万, 0) + COALESCE(燃气定制实际万, 0) + COALESCE(地产实际万, 0)) * 10000, 0) AS 年度开单金额,\n        COALESCE(线下任务万, 0) AS 线下任务_万元,\n        COALESCE(新零售任务万, 0) AS 新零售任务_万元,\n        COALESCE(燃气定制任务万, 0) AS 燃气定制任务_万元,\n        COALESCE(地产任务万, 0) AS 地产任务_万元,\n        COALESCE(线下实际万, 0) AS 线下实际_万元,\n        COALESCE(新零售实际万, 0) AS 新零售实际_万元,\n        COALESCE(燃气定制实际万, 0) AS 燃气定制实际_万元,\n        COALESCE(地产实际万, 0) AS 地产实际_万元\n    FROM 字段提取\n    WHERE 当前年 = '2026'\n      AND (事业部 = '消费者事业部' OR 分公司 <> '' OR 城市分公司 <> '')\n),\n汇总结果 AS (\n    SELECT\n        '消费者经营链路' AS 条线,\n        '全部' AS 分析口径,\n        层级,\n        节点名称,\n        上级名称,\n        ROUND((总任务金额), 2) AS 总任务金额,\n        ROUND((年度开单金额), 2) AS 年度开单金额,\n        CASE WHEN (总任务金额) > 0 THEN ROUND((年度开单金额) / (总任务金额) * 100, 2) ELSE 0 END AS 达成率,\n        ROUND(GREATEST((总任务金额) - (年度开单金额), 0), 2) AS 剩余任务金额,\n        ROUND(线下任务_万元, 2) AS 线下任务_万元,\n        ROUND(新零售任务_万元, 2) AS 新零售任务_万元,\n        ROUND(燃气定制任务_万元, 2) AS 燃气定制任务_万元,\n        ROUND(地产任务_万元, 2) AS 地产任务_万元,\n        ROUND(线下实际_万元, 2) AS 线下实际_万元,\n        ROUND(新零售实际_万元, 2) AS 新零售实际_万元,\n        ROUND(燃气定制实际_万元, 2) AS 燃气定制实际_万元,\n        ROUND(地产实际_万元, 2) AS 地产实际_万元\n    FROM 标准行\n    WHERE 节点名称 <> ''\n      AND ((总任务金额) > 0 OR (年度开单金额) > 0)\n)\nSELECT *\nFROM 汇总结果\n\nWHERE 节点名称 IN ('山东分公司')\n   OR 上级名称 IN ('山东分公司')\n   OR 上级名称 IN (\n       SELECT 节点名称\n       FROM 汇总结果\n       WHERE 节点名称 IN ('山东分公司') OR 上级名称 IN ('山东分公司')\n   )\n\nORDER BY\n    CASE 层级 WHEN '消费者事业部总体' THEN 0 WHEN '分公司' THEN 1 WHEN '城市分公司' THEN 2 ELSE 9 END,\n    上级名称 NULLS FIRST,\n    达成率 DESC,\n    节点名称\nLIMIT 10000\n) AS __smartask_row_scope\nWHERE ((to_jsonb(__smartask_row_scope)->>'组织编码') IN ('7c38ff2d14dd5515', '1f5bc53566bfa5b2', '4c92717a393b3248', 'e26cc888231cb3c9', '1bbd2a36b2fb686f', '4b66949a1g2g1e8c', '196873fd1d2cfg85', '843a34aa6g3gg763', 'b45ddd151517eag6', 'e99798612e98b4d6', 'bg18ddb2efb2gf61', 'egg37cg26bafg5a9', 'aa34g4b218a28bgf', 'egcc258a8d9c811f') OR (to_jsonb(__smartask_row_scope)->>'分公司编码') IN ('7c38ff2d14dd5515', '1f5bc53566bfa5b2', '4c92717a393b3248', 'e26cc888231cb3c9', '1bbd2a36b2fb686f', '4b66949a1g2g1e8c', '196873fd1d2cfg85', '843a34aa6g3gg763', 'b45ddd151517eag6', 'e99798612e98b4d6', 'bg18ddb2efb2gf61', 'egg37cg26bafg5a9', 'aa34g4b218a28bgf', 'egcc258a8d9c811f') OR (to_jsonb(__smartask_row_scope)->>'部门编码') IN ('7c38ff2d14dd5515', '1f5bc53566bfa5b2', '4c92717a393b3248', 'e26cc888231cb3c9', '1bbd2a36b2fb686f', '4b66949a1g2g1e8c', '196873fd1d2cfg85', '843a34aa6g3gg763', 'b45ddd151517eag6', 'e99798612e98b4d6', 'bg18ddb2efb2gf61', 'egg37cg26bafg5a9', 'aa34g4b218a28bgf', 'egcc258a8d9c811f') OR (to_jsonb(__smartask_row_scope)->>'节点编码') IN ('7c38ff2d14dd5515', '1f5bc53566bfa5b2', '4c92717a393b3248', 'e26cc888231cb3c9', '1bbd2a36b2fb686f', '4b66949a1g2g1e8c', '196873fd1d2cfg85', '843a34aa6g3gg763', 'b45ddd151517eag6', 'e99798612e98b4d6', 'bg18ddb2efb2gf61', 'egg37cg26bafg5a9', 'aa34g4b218a28bgf', 'egcc258a8d9c811f') OR POSITION('7c38ff2d14dd5515' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('1f5bc53566bfa5b2' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('4c92717a393b3248' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('e26cc888231cb3c9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('1bbd2a36b2fb686f' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('4b66949a1g2g1e8c' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('196873fd1d2cfg85' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('843a34aa6g3gg763' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('b45ddd151517eag6' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('e99798612e98b4d6' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('bg18ddb2efb2gf61' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('egg37cg26bafg5a9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('aa34g4b218a28bgf' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('egcc258a8d9c811f' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('7c38ff2d14dd5515' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('1f5bc53566bfa5b2' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('4c92717a393b3248' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('e26cc888231cb3c9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('1bbd2a36b2fb686f' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('4b66949a1g2g1e8c' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('196873fd1d2cfg85' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('843a34aa6g3gg763' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('b45ddd151517eag6' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('e99798612e98b4d6' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('bg18ddb2efb2gf61' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('egg37cg26bafg5a9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('aa34g4b218a28bgf' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('egcc258a8d9c811f' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('7c38ff2d14dd5515' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('1f5b