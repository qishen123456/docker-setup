                        "label": "风险",
                        "value": 10
                      }
                    ],
                    "intentPolicies": {
                      "ranking": {
                        "enabled": true,
                        "triggers": [
                          "排名",
                          "排行",
                          "Top",
                          "前",
                          "后",
                          "最高",
