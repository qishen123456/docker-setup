                          "最好",
                          "最差",
                          "倒数",
                          "垫底"
                        ],
                        "defaultTopN": 3,
                        "maxTopN": 20,
                        "defaultMetricKey": "rate",
                        "defaultDirection": "desc",
                        "negativeTriggers": [
