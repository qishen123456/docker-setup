                      {
                        "key": "actual",
                        "label": "年度开单金额",
                        "column": "年度开单金额",
                        "format": "amount"
                      },
                      {
                        "key": "rate",
                        "label": "达成率",
                        "column": "达成率",
                        "format": "percent"
                      },
                      {
                        "key": "remain",
                        "label": "剩余任务金额",
                        "column": "剩余任务金额",
                        "format": "amount"
                      }
                    ],
                    "amountUnitConvention": "元",
