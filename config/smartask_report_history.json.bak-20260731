                  "narrative": [
                    "本次结果覆盖 10 个业务代表",
                    "第一梯队：韩晓娇89.22%、周萌78.47%、张良76.06%、徐会峰71.69%",
                    "第二梯队：贾希66.14%、赵标57.25%、栾天龙55.34%",
                    "第三梯队：史利伟46.02%、吴三英44.35%、靳锋33.24%"
                  ],
                  "provenance": [
                    {
                      "provenanceId": "p_sql_result_001",
                      "type": "sql_result",
                      "sql": "SELECT * FROM (\nWITH 业务代表原始 AS (\n    SELECT\n        TRIM(COALESCE(CASE WHEN jsonb_typeof(fields->'分公司') = 'array' THEN fields->'分公司'->0->>'text' ELSE fields->>'分公司' END, '')) AS 分公司,\n        TRIM(COALESCE(CASE WHEN jsonb_typeof(fields->'代表处') = 'array' THEN fields->'代表处'->0->>'text' ELSE fields->>'代表处' END, '')) AS 代表处,\n        '' AS 业务部,\n        TRIM(COALESCE(CASE WHEN jsonb_typeof(fields->'业务代表') = 'array' THEN fields->'业务代表'->0->>'text' ELSE fields->>'业务代表' END, '')) AS 业务代表,\n        SUM(COALESCE(NULLIF(regexp_replace(COALESCE(CASE WHEN jsonb_typeof(fields->'总任务（金额）') = 'array' THEN fields->'总任务（金额）'->0->>'text' ELSE fields->>'总任务（金额）' END, '0'), '[^0-9.-]', '', 'g'), ''), '0')::NUMERIC) AS 总任务金额,\n        SUM(COALESCE(NULLIF(regexp_replace(COALESCE(CASE WHEN jsonb_typeof(fields->'年度开单金额') = 'array' THEN fields->'年度开单金额'->0->>'text' ELSE fields->>'年度开单金额' END, '0'), '[^0-9.-]', '', 'g'), ''), '0')::NUMERIC) AS 年度开单金额\n    FROM angel_group_data\n    WHERE COALESCE(NULLIF(TRIM(CASE WHEN jsonb_typeof(fields->'当前年') = 'array' THEN fields->'当前年'->0->>'text' ELSE fields->>'当前年' END), ''), '2026') = '2026'\n    GROUP BY 1, 2, 3, 4\n),\n业务代表汇总 AS (\n    SELECT\n        CASE\n            WHEN COALESCE(NULLIF(分公司, ''), NULLIF(业务部, '')) LIKE '%业务部' THEN '行业条线'\n            WHEN COALESCE(NULLIF(分公司, ''), NULLIF(业务部, '')) LIKE '%分公司' THEN '区域条线'\n            ELSE '事业部层级'\n        END AS 条线,\n        '业务代表' AS 层级,\n        业务代表 AS 节点名称,\n        COALESCE(NULLIF(代表处, ''), NULLIF(业务部, ''), NULLIF(分公司, ''), '商用事业部') AS 上级名称,\n        NULLIF(分公司, '') AS 分公司,\n        NULLIF(代表处, '') AS 代表处,\n        NULLIF(业务部, '') AS 业务部,\n        concat_ws(' / ', NULLIF(分公司, ''), NULLIF(代表处, ''), NULLIF(业务部, ''), NULLIF(业务代表, '')) AS 组织路径,\n        SUM(总任务金额) AS 总任务金额,\n        SUM(年度开单金额) AS 年度开单金额\n    FROM 业务代表原始\n    WHERE 业务代表 <> ''\n    GROUP BY 分公司, 代表处, 业务部, 业务代表\n),\n业务代表结果 AS (\n    SELECT\n        条线,\n        层级,\n        组织路径,\n        节点名称,\n        上级名称,\n        分公司,\n        代表处,\n        业务部,\n        总任务金额,\n        年度开单金额,\n        CASE WHEN 总任务金额 = 0 THEN 0 ELSE ROUND((年度开单金额 / 总任务金额) * 100, 2) END AS 达成率,\n        ROUND(总任务金额 - 年度开单金额, 2) AS 剩余任务金额\n    FROM 业务代表汇总\n)\n,\n业务代表全局排序 AS (\n    SELECT\n        *,\n        ROW_NUMBER() OVER (\n            ORDER BY 年度开单金额 DESC, 剩余任务金额 DESC, 组织路径\n        ) AS 全局排名\n    FROM 业务代表结果\n)\nSELECT *\nFROM 业务代表全局排序\nWHERE 全局排名 <= 10\nORDER BY 全局排名, 年度开单金额 DESC, 剩余任务金额 DESC, 组织路径\nLIMIT 10\n) AS __smartask_row_scope\nWHERE ((to_jsonb(__smartask_row_scope)->>'组织编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR (to_jsonb(__smartask_row_scope)->>'分公司编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR (to_jsonb(__smartask_row_scope)->>'部门编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR (to_jsonb(__smartask_row_scope)->>'节点编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_json