                        ],
                        "label": "行业管理链条",
                        "purpose": "分析餐饮、工业医疗、公共办公等行业线专业产出和个人产能。",
                        "trackValue": "行业条线",
                        "sourceFields": [
                          "分公司",
                          "业务代表"
                        ]
                      }
                    ],
                    "metrics": [
                      {
                        "key": "task",
