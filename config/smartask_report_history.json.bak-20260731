 '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'城市公司') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'部门') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'条线') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'区域') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'公司名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR POSITION('商用事业部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('东部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('工业医疗业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('北部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('西部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('公共办公业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('南部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('餐饮业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('商用事业部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('东部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('工业医疗业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('北部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('西部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('公共办公业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('南部分公司' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR POSITION('餐饮业务部' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织全路径'), '')) > 0 OR