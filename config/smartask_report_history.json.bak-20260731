                      "剩余任务金额"
                    ],
                    "analysis_dimension_count": 2,
                    "metric_count": 4,
                    "signal_rule_count": 3
                  },
                  "layoutTemplate": "detail",
                  "analysisMode": "detail"
                },
                "data_source": "商用事业部开单金额",
                "sql": "SELECT * FROM (\nWITH RECURSIVE 汇总结果 AS (\nWITH raw_data AS (\n    SELECT\n        TRIM(COALESCE(CASE WHEN jsonb_typeof(fields->'分公司') = 'array' THEN fields->'分公司'->0->>'text' ELSE fields->>'分公司' END, '')) AS 分公司,\n        TRIM(COALESCE(CASE WHEN jsonb_typeof(fields->'代表处') = 'array' THEN fields->'代表处'->0->>'text' ELSE fields->>'代表处' END, '')) AS 代表处,\n        TRIM(COALESCE(CASE WHEN jsonb_typeof(fields->'业务代表') = 'array' THEN fields->'业务代表'->0->>'text' ELSE fields->>'业务代表' END, '')) AS 业务代表,\n        '' AS 业务部,\n        SUM(COALESCE(NULLIF(regexp_replace(COALESCE(CASE WHEN jsonb_typeof(fields->'总任务（金额）') = 'array' THEN fields->'总任务（金额）'->0->>'text' ELSE fields->>'总任务（金额）' END, '0'), '[^0-9.-]', '', 'g'), ''), '0')::NUMERIC) AS 总任务金额,\n        SUM(COALESCE(NULLIF(regexp_replace(COALESCE(CASE WHEN jsonb_typeof(fields->'年度开单金额') = 'array' THEN fields->'年度开单金额'->0->>'text' ELSE fields->>'年度开单金额' END, '0'), '[^0-9.-]', '', 'g'), ''), '0')::NUMERIC) AS 年度开单金额\n    FROM angel_group_data\n    WHERE COALESCE(NULLIF(TRIM(CASE WHEN jsonb_typeof(fields->'当前年') = 'array' THEN fields->'当前年'->0->>'text' ELSE fields->>'当前年' END), ''), '2026') = '2026'\n    GROUP BY 1, 2, 3, 4\n),\nflattened_tree AS (\n    SELECT\n        CASE\n            WHEN 业务代表 <> '' THEN '业务代表'\n            WHEN 代表处 <> '' THEN '代表处'\n            WHEN 分公司 <> '' AND 分公司 LIKE '%业务部' THEN '业务部'\n            WHEN 业务部 <> '' THEN '业务部'\n            WHEN 分公司 <> '' THEN '分公司'\n            ELSE '事业部'\n        END AS 层级,\n        CASE\n            WHEN 业务代表 <> '' THEN COALESCE(NULLIF(代表处, ''), NULLIF(业务部, ''), NULLIF(分公司, ''), '商用事业部')\n            WHEN 代表处 <> '' THEN NULLIF(分公司, '')\n            WHEN 分公司 <> '' OR 业务部 <> '' THEN '商用事业部'\n            ELSE NULL\n        END AS 上级名称,\n        CASE\n            WHEN 业务代表 <> '' THEN 业务代表\n            WHEN 代表处 <> '' THEN 代表处\n            WHEN 分公司 <> '' THEN 分公司\n            WHEN 业务部 <> '' THEN 业务部\n            ELSE '商用事业部'\n        END AS 节点名称,\n        CASE\n            WHEN COALESCE(NULLIF(分公司, ''), NULLIF(业务部, '')) LIKE '%业务部' THEN '行业条线'\n            WHEN COALESCE(NULLIF(分公司, ''), NULLIF(业务部, '')) LIKE '%分公司' THEN '区域条线'\n            ELSE '事业部层级'\n        END AS 条线,\n        '商用事业部' AS 事业部,\n        分公司,\n        代表处,\n        业务部,\n        业务代表,\n        总任务金额,\n        年度开单金额\n    FROM raw_data\n    UNION ALL\n    -- 修复：数据集中“分公司”字段同时存放区域分公司和行业业务部。\n    -- 当用户按“分公司”口径查询时，额外输出一行业务部叶子节点作为分公司层级，\n    -- 避免“达成率超过80%的分公司”因公共办公业务部被归类为业务部而漏掉。\n    SELECT\n        '分公司' AS 层级,\n        '商用事业部' AS 上级名称,\n        分公司 AS 节点名称,\n        '行业条线' AS 条线,\n        '商用事业部' AS 事业部,\n        分公司,\n        '' AS 代表处,\n        分公司 AS 业务部,\n        '' AS 业务代表,\n        总任务金额,\n        年度开单金额\n    FROM raw_data\n    WHERE 分公司 <> '' AND 分公司 LIKE '%业务部' AND 代表处 = '' AND 业务代表 = ''\n),\nsummarized_nodes AS (\n    SELECT\n        条线,\n        层级,\n        上级名称,\n        节点名称,\n        MAX(事业部) AS 事业部,\n        MAX(分公司) AS 分公司,\n        MAX(代表处) AS 代表处,\n        MAX(业务部) AS 业务部,\n        MAX(业务代表) AS 业务代表,\n        SUM(总任务金额) AS 总任务金额,\n        SUM(年度开单金额) AS 年度开单金额\n    FROM flattened_tree\n    WHERE 节点名称 <> ''\n    GROUP BY 条线, 层级, 上级名称, 节点名称\n    UNION ALL\n    SELECT\n        '事业部层级' AS 条线,\n        '事业部' AS 层级,\n        NULL AS 上级名称,\n        '商用事业部' AS 节点名称,\n        '商用事业部' AS 事业部,\n        '' AS 分公司,\n        '' AS 代表处,\n        '' AS 业务部,\n        '' AS 业务代表,\n        SUM(总任务金额) AS 总任务金额,\n        SUM(年度开单金额) AS 年度开单金额\n    FROM flattened_tree\n    WHERE 上级名称 = '商用事业部'\n      AND 层级 IN ('分公司', '业务部')\n      AND NOT (条线 = '行业条线' AND 层级 = '分公司')\n)\nSELECT\n    条线,\n    层级,\n    节点名称,\n    上级名称,\n    事业部,\n    分公司,\n    代表处,\n    业务部,\n    业务代表,\n    总任务金额,\n    年度开单金额,\n    CASE WHEN 总任务金额 = 0 THEN 0 ELSE ROUND((年度开单金额 / 总任务金额) * 100, 2) END AS 达成率,\n    ROUND(总任务金额 - 年度开单金额, 2) AS 剩余任务金额\nFROM summarized_nodes\n),\n命中链路 AS (\n    SELECT *, 1 AS _depth\n    FROM 汇总结果\n    WHERE 节点名称 IN ('商用事业部')\n    UNION ALL\n    SELECT 子节点.*, 父节点._depth + 1\n    FROM 汇总结果 子节点\n    JOIN 命中链路 父节点\n      ON 子节点.上级名称 = 父节点.节点名称\n    WHERE 父节点._depth < 2\n)\nSELECT *\nFROM (\n    SELECT DISTINCT ON (节点名称) *\n    FROM 命中链路\n    WHERE _depth <= 2\n    ORDER BY 节点名称, _depth\n) 去重后\nORDER BY 条线 DESC,\n  CASE 层级\n    WHEN '事业部' THEN 0\n    WHEN '分公司' THEN 1\n    WHEN '业务部' THEN 1\n    WHEN '代表处' THEN 2\n    WHEN '业务代表' THEN 3\n    ELSE 9\n  END,\n  上级名称,\n  节点名称\nLIMIT 10000\n) AS __smartask_row_scope\nWHERE ((to_jsonb(__smartask_row_scope)->>'组织编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR (to_jsonb(__smartask_row_scope)->>'分公司编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR (to_jsonb(__smartask_row_scope)->>'部门编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR (to_jsonb(__smartask_row_scope)->>'节点编码') IN ('28b5364e2f181bfg', 'gg9c5c9ce5c3faa9', '96a9gc77a35e5ee5', 'eb2685cfab3651df', '195c4ac5f864de57', '63aa3gb14a191aee', 'b8a3gda6d426a699', 'ef5bd91dc373gfbg') OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织编码路径'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'路径编码'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织路径'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'组织链路'), '')) > 0 OR POSITION('28b5364e2f181bfg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('gg9c5c9ce5c3faa9' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('96a9gc77a35e5ee5' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('eb2685cfab3651df' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('195c4ac5f864de57' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('63aa3gb14a191aee' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('b8a3gda6d426a699' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR POSITION('ef5bd91dc373gfbg' IN COALESCE((to_jsonb(__smartask_row_scope)->>'链接字段(勿删)'), '')) > 0 OR (to_jsonb(__smartask_row_scope)->>'节点名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'上级名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'组织名称') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'分公司') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'事业部') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'业务部') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部', '南部分公司', '餐饮业务部') OR (to_jsonb(__smartask_row_scope)->>'代表处') IN ('商用事业部', '东部分公司', '工业医疗业务部', '北部分公司', '西部分公司', '公共办公业务部',