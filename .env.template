# ============================================================
# SmartAsk 环境变量配置模板
# 使用方法: cp .env.template .env && vim .env
# ⚠️ 标记 [手动] 的项必须修改，标记 [可选] 的按需填写
# ============================================================

# ===== [手动] 数据库配置 =====
SMARTASK_DB_DATABASE=smartask_db
SMARTASK_DB_USERNAME=smartask_user
SMARTASK_DB_PASSWORD=请修改为强密码_至少32位字符
SMARTASK_POSTGRES_PASSWORD=${SMARTASK_DB_PASSWORD}
SMARTASK_DOCKER_PG_PORT=5433

# ===== [手动] 后端服务配置 =====
SMARTASK_BACKEND_PORT=5002
SMARTASK_FRONTEND_PORT=8888

# ===== [手动] 管理员账号（首次部署后立即登录修改）=====
SMARTASK_ADMIN_USERNAME=admin
SMARTASK_ADMIN_PASSWORD=请设置管理员密码_不能是admin123456
SMARTASK_ADMIN_DISPLAY_NAME=系统管理员

# ===== [手动] AI模型配置（必填！）=====
# 选项A：OpenAI官方接口
SMARTASK_AI_API_KEY=sk-你的OpenAI_API_Key
SMARTASK_AI_BASE_URL=https://api.openai.com/v1/
SMARTASK_AI_MODEL=gpt-4o

# 选项B：DeepSeek兼容接口（推荐，性价比高）
# SMARTASK_AI_API_KEY=sk-你的DeepSeek_API_Key
# SMARTASK_AI_BASE_URL=https://api.deepseek.com/v1/
# SMARTASK_AI_MODEL=deepseek-chat

# 选项C：其他兼容OpenAI格式的接口
# SMARTASK_AI_API_KEY=your-api-key
# SMARTASK_AI_BASE_URL=https://your-api-endpoint/v1/
# SMARTASK_AI_MODEL=model-name

# ===== [手动] 安全密钥（用于Session/JWT签名）=====
# ⚠️ 生产环境必须随机生成，不要使用默认值！
# 生成命令: python3 -c "import secrets; print(secrets.token_hex(32))"
SMARTASK_SECRET_KEY=请运行上述命令生成随机密钥替换此处

# ===== [手动] Flask Session密钥 =====
SECRET_KEY=请生成另一个随机密钥替换此处

# ===== [可选] 飞书集成（如果使用飞书数据同步）=====
SMARTASK_FEISHU_APP_ID=
SMARTASK_FEISHU_APP_SECRET=

# ===== [可选] Docker镜像加速（国内服务器推荐）=====
SMARTASK_APT_MIRROR=https://mirrors.aliyun.com
SMARTASK_NPM_REGISTRY=https://registry.npmmirror.com
SMARTASK_DOCKER_REGISTRY_MIRRORS=https://docker.m.daocloud.io,https://docker.1ms.run

# ===== [可选] Bootstrap控制（一般不需要改）=====
SMARTASK_BOOTSTRAP_SKIP_BUILTINS=1
SMARTASK_BOOTSTRAP_SKIP_FIRST_IMPORT=1

# ===== [可选] 飞书同步启动模式 =====
# auto（默认）：智能判断，空表/新表启动同步，已有数据跳过
# force：启动强制同步所有启用配置
# skip：跳过启动同步，仅启动定时任务（本地开发推荐）
SMARTASK_FEISHU_SYNC_ON_STARTUP=auto

# ===== [高级] 加密配置（首次部署可忽略）=====
# 如果 .env 或 config/*.json 使用 enc:v1 密文格式，需提供主密钥
# SMARTASK_SECRET_MASTER_KEY=
# SMARTASK_SECRET_KEY_FILE=config/.secret_master_key
