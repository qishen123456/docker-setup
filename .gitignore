# Docker bind-mount runtime data (DO NOT delete these directories; they are mounted into containers)
# - logs/          : feishu sync logs + fallback system logs
# - backend/logs/  : backend fallback system logs
# - backend/data/  : agent_registry.json + optional legacy dataset_dimension_profiles.json
# - config/        : runtime JSON configs (already protected below)
# - backups/       : runtime backups
# - backend/imports/: import bundles
# They are gitignored so generated files don't get committed, but the directories must exist.
logs/
backend/logs/
backend/data/
diagnostics/
backups/
backend/imports/*_backup_*.json

