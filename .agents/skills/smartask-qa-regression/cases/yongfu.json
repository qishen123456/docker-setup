        },
        {
          "path": "dataset_results.0.row_count",
          "op": "eq",
          "expect": 3
        }
      ]
    },
    {
      "id": "YF4-bottom3",
      "question": "用服垫底的三个分公司",
      "source": "用服接入基线 2026-09-03 / baseline §2.6",
      "asserts": [
        {
          "path": "route.dataset_ids",
          "op": "eq",
          "expect": [
            64
          ]
        },
        {
          "path": "dataset_results.0.query_intent.direction",
          "op": "eq",
          "expect": "asc"
        },
        {
          "path": "dataset_results.0.row_count",
          "op": "eq",
