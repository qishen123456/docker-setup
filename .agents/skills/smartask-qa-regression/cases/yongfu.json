    },
    {
      "id": "YF5-prefix-single",
      "question": "用服粤桂琼分公司的业绩怎么样",
      "source": "用服接入基线 2026-09-03 / baseline §3.6(唯一真实节点直出)",
      "asserts": [
        {
          "path": "requires_confirmation",
          "op": "eq",
          "expect": false
        },
        {
          "path": "route.dataset_ids",
          "op": "eq",
          "expect": [
            64
          ]
        },
        {
          "path": "dataset_results.0.row_count",
          "op": "gte",
          "expect": 1
        },
        {
          "path": "dataset_results.0.rows.0.节点名称",
          "op": "contains",
          "expect": "粤桂琼"
        }
      ]
    },
    {
      "id": "YF6-bare-ambig",
      "question": "粤桂琼分公司业绩",
      "source": "用服接入基线 2026-09-03 / baseline §3.5(裸节点多数据集弹真实节点卡)",
      "asserts": [
        {
          "path": "requires_confirmation",
          "op": "allow_confirm"
        }
      ],
      "confirm": [
        {
          "select": {
            "dataset_ids": [
              64
            ]
          },
          "asserts": [
            {
              "path": "route.dataset_ids",
              "op": "eq",
              "expect": [
                64
              ]
            },
            {
              "path": "dataset_results.0.row_count",
              "op": "gte",
              "expect": 1
            },
            {
              "path": "dataset_results.0.rows.0.节点名称",
              "op": "contains",
              "expect": "粤桂琼"
            }
          ]
        },
        {
          "select": {
            "dataset_ids": [
              2
            ]
          },
          "asserts": [
            {
              "path": "route.dataset_ids",
              "op": "eq",
              "expect": [
                2
              ]
            },
            {
              "path": "dataset_results.0.row_count",
              "op": "gte",
              "expect": 1
            }
          ]
        }
      ]
    },
    {
      "id": "YF7-filter",
      "question": "用服达成率大于50%的分公司有哪些",
      "source": "用服接入基线 2026-09-03 / baseline §筛选",
      "asserts": [
        {
          "path": "route.dataset_ids",
          "op": "eq",
          "expect": [
            64
          ]
        },
        {
          "path": "dataset_results.0.query_intent.intent",
          "op": "eq",
          "expect": "filter"
        },
        {
          "path": "dataset_results.0.row_count",
          "op": "range",
          "expect": [
            10,
            15
          ]
        }
      ]
    },
    {
