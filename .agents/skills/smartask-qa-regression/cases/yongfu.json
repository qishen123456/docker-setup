{
  "cases": [
    {
      "id": "YF1-overview",
      "question": "用服事业部业绩怎么样",
      "source": "用服接入基线 2026-09-03（2026-09-06 飞书漂移 分公司14→13，gte 15→14）",
      "asserts": [
        {
          "path": "route.dataset_ids",
          "op": "eq",
          "expect": [
            64
          ]
        },
        {
          "path": "requires_confirmation",
          "op": "eq",
          "expect": false
        },
        {
          "path": "dataset_results.0.row_count",
          "op": "gte",
          "expect": 14
        }
      ]
    },
    {
      "id": "YF2-rank-all",
      "question": "用服各分公司业绩排名",
      "source": "用服接入基线 2026-09-03 / baseline §2.1(不默认Top3)",
      "asserts": [
        {
          "path": "route.dataset_ids",
          "op": "eq",
          "expect": [
            64
          ]
        },
        {
          "path": "dataset_results.0.query_intent.intent",
          "op": "eq",
          "expect": "ranking"
        },
        {
          "path": "dataset_results.0.row_count",
          "op": "gte",
          "expect": 13
        }
      ]
    },
    {
      "id": "YF3-top3",
